JIRA_BASE_URL=https://jira.nimhda.org
JIRA_API_PATH=/rest/api/2
JIRA_AUTH_MODE=bearer
JIRA_PAT=replace-me

# Basic auth alternative:
# JIRA_AUTH_MODE=basic
# JIRA_USERNAME=replace-me
# JIRA_PASSWORD=replace-me

# Optional defaults:
# JIRA_PROJECT_KEY=ENG
# JIRA_JQL_FILTER=resolution = Unresolved

# Optional guardrails. Set JIRA_ALLOWED_PROJECTS to restrict every read/write
# to specific projects. Blocked labels are enforced by default if omitted.
# Matching Jira issue security levels are blocked too.
# JIRA_ALLOWED_PROJECTS=PMO,DB,REV
# JIRA_BLOCKED_LABELS=sensitive,restricted,phi,pii,security
